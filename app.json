{
  "expo": {
    "name": "After",
    "slug": "after",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "after",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "dev.davidko.after",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.davidko.after",
      "adaptiveIcon": {
        "backgroundColor": "#356146",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "After uses your selected meal photo to help you journal what you ate.",
          "cameraPermission": "After uses the camera only when you choose to photograph a meal.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#356146"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "6a87e8ab-9fe2-4827-b672-fd86863d80cb"
      }
    },
    "owner": "david_ko"
  }
}
